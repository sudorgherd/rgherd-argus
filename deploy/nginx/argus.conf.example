server {
    listen 80;
    listen [::]:80;
    server_name argus.example.org;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name argus.example.org;

    ssl_certificate /etc/letsencrypt/live/argus.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/argus.example.org/privkey.pem;

    root /opt/argus/frontend;
    index index.html;

    location ~ ^/(api|login|logout|auth|me|console|access-denied)(/|$) {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
