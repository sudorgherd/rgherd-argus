# ARGUS environment example
# Copy to .env on the deployment host and replace placeholders.
# Do not commit real secrets.

# -------------------------------------------------------------------
# Core app
# -------------------------------------------------------------------

# Public base URL for this ARGUS deployment.
# Example: https://argus.example.org
ARGUS_BASE_URL=https://argus.example.org

# Strong random session secret.
# Example generation:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-random-session-secret

# PostgreSQL connection URL.
# Example:
#   postgresql://argus_user:replace-with-db-password@127.0.0.1:5432/argus
DATABASE_URL=postgresql://argus_user:replace-with-db-password@127.0.0.1:5432/argus

# -------------------------------------------------------------------
# MAS / OIDC
# -------------------------------------------------------------------

# MAS issuer URL.
# Usually the public MAS base URL with trailing slash.
# Example: https://auth.example.org/
MAS_ISSUER=https://auth.example.org/

# OIDC client registered in MAS for ARGUS.
MAS_CLIENT_ID=argus
MAS_CLIENT_SECRET=replace-with-mas-client-secret

# Optional MAS Admin API support for user lookup/onboarding helpers.
# Leave blank if not using MAS admin lookup.
MAS_ADMIN_BASE_URL=
MAS_ADMIN_CLIENT_ID=
MAS_ADMIN_CLIENT_SECRET=
MAS_ADMIN_REQUEST_TIMEOUT_SECONDS=8

# -------------------------------------------------------------------
# Matrix notification connector
# -------------------------------------------------------------------

# Matrix homeserver client API base URL.
# Example: https://matrix.example.org
MATRIX_HOMESERVER_URL=https://matrix.example.org

# Dedicated Matrix service account used by ARGUS for alerts.
# Example: @argus-bot:example.org
MATRIX_SENDER_USER_ID=@argus-bot:example.org

# Access token for the Matrix service account.
MATRIX_ACCESS_TOKEN=replace-with-matrix-service-account-token

# Default request timeout for Matrix API calls.
MATRIX_REQUEST_TIMEOUT_SECONDS=10

# Matrix user domain used when deriving Matrix IDs from MAS usernames.
# Example: example.org
MATRIX_USER_DOMAIN=example.org
